{
  "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
  "name": "muxy-zh-hans",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Muxy 简体中文语言包 / Simplified Chinese language pack for Muxy 2.x",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "python3 scripts/validate.py"
  },
  "muxy": {
    "description": "Muxy 简体中文语言包 — 覆盖界面、设置、菜单与常用面板 (Simplified Chinese UI language for Muxy 2.x)",
    "localizations": [
      {
        "id": "zh-Hans",
        "language": "zh-Hans",
        "title": "简体中文",
        "bundle": "localization/SimplifiedChinese.bundle"
      }
    ],
    "marketplace": {
      "author": "sam5440",
      "github": "sam5440",
      "categories": ["localization"],
      "icon": "icon.svg"
    }
  }
}
